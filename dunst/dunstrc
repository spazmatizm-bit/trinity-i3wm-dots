[global]
    monitor = 0
    follow = mouse
    width = 308
    height = 252
    origin = top-right
    offset =  10x40
    notification_limit = 5
    progress_bar = true
    progress_bar_height = 8
    transparency = 10
    separator_height = 1
    padding = 6
    horizontal_padding = 12
    frame_width = 1
    frame_color = "#7fb08a"
    gap_size = 8
    sort = yes
    idle_threshold = 120
    font = FiraCode Nerd Font Mono 10
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    icon_position = left
    max_icon_size = 32
    corner_radius = 5
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#3a4a3e"
    foreground = "#e0e8dc"
    timeout = 2

[urgency_normal]
    background = "#1e2720"
    foreground = "#e0e8dc"
    frame_color = "#7fb08a"
    timeout = 3

[urgency_critical]
    background = "#c97064"
    foreground = "#1e2720"
    frame_color = "#c97064"
    timeout = 3
